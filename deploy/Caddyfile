# HTTPS automático (Let's Encrypt) para a API de login. O domínio vem do .env (GAME_DOMAIN).
# Só /api/* passa para o servidor; /metrics fica de fora (é só para dentro da VPS).
{$GAME_DOMAIN} {
	encode gzip

	handle /api/* {
		reverse_proxy game:7778
	}

	# Versões do cliente para o launcher (Tools/launcher/publicar.ps1 envia para deploy/download na VPS).
	# Os arquivos têm o hash no nome e nunca mudam; o versao.json muda a cada publicação.
	handle_path /download/* {
		root * /srv/download
		@versao path /versao.json
		header @versao Cache-Control "no-cache"
		header /arquivos/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		respond "Servidor do jogo." 200
	}
}
