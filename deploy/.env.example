# Copie para .env e preencha (o .env nunca vai para o GitHub).

# Domínio que aponta para o IP da VPS (registro A no DNS). O Caddy pega o certificado HTTPS sozinho.
GAME_DOMAIN=jogo.exemplo.com.br

# Senha do banco: longa e aleatória (ex.: openssl rand -hex 24). Não mude depois de subir pela primeira vez.
GAME_DB_PASSWORD=troque-esta-senha

# Imagem do servidor publicada pelo GitHub Actions.
GAME_IMAGE=ghcr.io/lucashevandro/astralis-server:latest

# Conexões do mesmo IP ao mesmo tempo.
GAME_MAX_PER_IP=8

# Backup diário: hora (0 a 23, horário de Brasília) e quantos guardar.
BACKUP_HOUR=4
BACKUP_KEEP=14

# Cópia para fora da VPS (opcional, perfil "offsite"): remoto do rclone e pasta, ex.: b2:meu-bucket/jogo
RCLONE_TARGET=
