<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Launcher do jogo: confere a versão publicada na VPS, baixa só os arquivos que mudaram e abre o jogo.
    .NET Framework 4.8 (já vem no Windows 10 e 11): o jogador não instala nada, e o exe fica pequeno.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>TerrasDeAstralisLauncher</AssemblyName>
    <RootNamespace>Game.Launcher</RootNamespace>
    <ApplicationIcon>..\instalador\icone.ico</ApplicationIcon>
    <Product>Terras de Astralis</Product>
    <Company>Astralis</Company>
    <AssemblyTitle>Terras de Astralis</AssemblyTitle>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <EmbeddedResource Include="..\..\Client\Assets\Art\Icone\TerrasDeAstralis.png" LogicalName="brasao.png" />
  </ItemGroup>

</Project>
